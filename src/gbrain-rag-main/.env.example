GBRAIN_RAG_HOST=0.0.0.0
GBRAIN_RAG_PORT=6061
GBRAIN_RAG_DATA_SOURCE_DIR=data_source
GBRAIN_RAG_INDEX_DB_PATH=data/index/gbrain.sqlite3

# Use "sentence-transformers" for the default bge_m3 semantic index.
# For quick smoke tests, override with: GBRAIN_RAG_EMBEDDING_BACKEND=hashing
GBRAIN_RAG_EMBEDDING_BACKEND=sentence-transformers
GBRAIN_RAG_EMBEDDING_MODEL=bge_m3
GBRAIN_RAG_EMBEDDING_DEVICE=cuda
GBRAIN_RAG_HASHING_DIM=384

# OpenAI-compatible LLM endpoint. Defaults mirror swift-rag and can be overridden.
GBRAIN_RAG_LLM_MODEL=Qwen3.5-4B
GBRAIN_RAG_LLM_BASE_URL=http://10.111.32.253:8000/v1
GBRAIN_RAG_LLM_API_KEY=token.sdc@2026
GBRAIN_RAG_LLM_MAX_TOKENS=2048
GBRAIN_RAG_LLM_TEMPERATURE=0.1
GBRAIN_RAG_LLM_TOP_P=0.5
GBRAIN_RAG_ENABLE_LLM_QUERY_EXPANSION=true
GBRAIN_RAG_LLM_QUERY_EXPANSION_MAX_TERMS=8
GBRAIN_RAG_GRAPH_WEIGHT=0.28
GBRAIN_RAG_STRUCTURED_WEIGHT=0.45
